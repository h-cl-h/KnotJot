<Project Sdk="Microsoft.NET.Sdk">

  <!-- Define the Windows runtime and project compilation identity.
       定义 Windows 运行时与项目编译身份。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KnotJot界面编辑器</AssemblyName>
    <RootNamespace>KnotJotUiEditor</RootNamespace>
    <Version>1.0.0</Version>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Declare package, source, content, or project dependencies for this build.
       声明本构建的软件包、源码、内容或工程依赖。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- Declare package, source, content, or project dependencies for this build.
       声明本构建的软件包、源码、内容或工程依赖。 -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <!-- Declare package, source, content, or project dependencies for this build.
       声明本构建的软件包、源码、内容或工程依赖。 -->
  <ItemGroup>
    <Content Include="protocols\ui-skin-protocol.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD_PARTY_LICENSES\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

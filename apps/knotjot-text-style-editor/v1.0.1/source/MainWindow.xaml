<!-- EN: Declare the branded main window and persistent control names consumed by code-behind and smoke tests.
     ZH: 声明品牌主窗口，以及代码和 smoke 测试依赖的稳定控件名称。 -->
<Window x:Class="KnotJotTextStyleEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KnotJot Text Style Editor V1.0.1" Icon="assets/icon.ico" Width="1450" Height="850" MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei" Background="#F4F6F9">
<!-- EN: Apply common spacing and appearance to buttons, editors, selectors, and property labels.
     ZH: 为按钮、输入框、选择器及属性标签应用公共间距和外观。 -->
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="11,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,2,0,7"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="0,2,0,7"/></Style>
  <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Foreground" Value="#596174"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
 </Window.Resources>
 <Grid>
<!-- EN: Keep the editing surface hidden until a Home action opens or creates a document.
     ZH: 在开始页操作打开或创建文档之前隐藏编辑界面。 -->
 <DockPanel x:Name="EditorRoot" Visibility="Collapsed">
<!-- EN: Provide document commands, undo/redo, target connection, synchronization, launch, tools, and language switching.
     ZH: 提供文档命令、撤销重做、目标连接、同步、启动、工具和语言切换。 -->
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE2EB" BorderThickness="0,0,0,1" Padding="12,7"><StackPanel>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal"><Button x:Name="HomeBtn" Content="开始页"/><Button x:Name="NewBtn" Content="新建"/><Button x:Name="OpenBtn" Content="打开样式"/><Button x:Name="SaveBtn" Content="保存"/><Button x:Name="SaveAsBtn" Content="另存为…"/><Button x:Name="UndoBtn" Content="撤销"/><Button x:Name="RedoBtn" Content="重做"/><Button x:Name="ConnectBtn" Content="连接主程序…" Background="#E8F0FF"/><Button x:Name="SyncBtn" Content="保存并同步" Background="#5B8DEF" Foreground="White"/><Button x:Name="LaunchBtn" Content="打开主程序"/><Button x:Name="FloatToolsBtn" Content="浮动工具"/><Button x:Name="LanguageBtn" Content="EN"/></StackPanel></ScrollViewer>
   <TextBlock x:Name="ConnectionText" Margin="2,5,2,0" Foreground="#697184" Text="未连接主程序（可独立使用）" TextWrapping="Wrap"/>
  </StackPanel></Border>
<!-- EN: Present transient operation feedback separately from validation and connection status.
     ZH: 独立展示临时操作反馈，与校验和连接状态分开。 -->
  <Border DockPanel.Dock="Bottom" Background="#EAF1FF" Padding="10,6"><TextBlock x:Name="StatusText" Foreground="#315EAE" Text="就绪"/></Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
<!-- EN: Expose drawing tools and grid/object/aspect snapping controls used by canvas gestures.
     ZH: 展示画布操作使用的绘图工具及网格、对象、比例吸附控件。 -->
   <Border Grid.Column="0" Background="White" BorderBrush="#DDE2EB" BorderThickness="0,0,1,0"><ScrollViewer><StackPanel Margin="12">
    <TextBlock Text="绘制工具" FontSize="15" FontWeight="Bold" Margin="0,2,0,8"/>
    <Button x:Name="SelectTool" Content="选择 / 移动" HorizontalContentAlignment="Left" Margin="0,3"/>
    <Button x:Name="RectTool" Content="矩形" HorizontalContentAlignment="Left" Margin="0,3"/>
    <Button x:Name="RoundTool" Content="圆角矩形" HorizontalContentAlignment="Left" Margin="0,3"/>
    <Button x:Name="EllipseTool" Content="椭圆" HorizontalContentAlignment="Left" Margin="0,3"/>
    <Button x:Name="LineTool" Content="直线" HorizontalContentAlignment="Left" Margin="0,3"/>
    <Button x:Name="ImportImageBtn" Content="导入图片…" HorizontalContentAlignment="Left" Margin="0,3"/>
    <Button x:Name="TextTool" Content="文本区域（重画会替换）" HorizontalContentAlignment="Left" Margin="0,3"/>
    <CheckBox x:Name="SquareSnapBox" Content="比例吸附：1:1 / 4:3 / 3:2 / 16:9" IsChecked="True" Margin="0,10,0,3"/>
    <CheckBox x:Name="ObjectSnapBox" Content="吸附其他图层的边缘和中心" IsChecked="True" Margin="0,3"/>
    <CheckBox x:Name="GridSnapBox" Content="网格吸附" IsChecked="True" Margin="0,3"/>
    <TextBlock Style="{StaticResource Label}" Text="网格大小（像素）"/><TextBox x:Name="GridSizeBox" Text="10"/>
    <TextBlock Style="{StaticResource Label}" Text="绘制长宽比（0=自由，例如 1、1.5、16/9）"/>
    <TextBox x:Name="DrawRatioBox" Text="0"/>
    <TextBlock TextWrapping="Wrap" Foreground="#7C8495" FontSize="12" Margin="0,14,0,0" Text="右侧图层面板可拖动排序。"/>
   </StackPanel></ScrollViewer></Border>
<!-- EN: Separate the fixed 900 by 520 authoring canvas from the measured independent text preview.
     ZH: 分开展示固定 900 乘 520 设计画布和实测独立文字预览。 -->
   <TabControl Grid.Column="1" x:Name="WorkTabs" Margin="12">
    <TabItem Header="设计画布"><Border Background="#DDE1E8" Padding="24"><Viewbox Stretch="Uniform"><Border Background="White" BorderBrush="#AEB6C5" BorderThickness="1"><Canvas x:Name="DesignCanvas" Width="900" Height="520" Background="#FFFFFF" ClipToBounds="True"/></Border></Viewbox></Border></TabItem>
<!-- EN: Share one card coordinate system between visual layers and the editable text region; scroll when content grows.
     ZH: 图层和可编辑文字区域共用卡片坐标系，内容增长时允许滚动。 -->
      <!-- EN: Place the complete CSS frame below editable content; its bitmap includes background, border, and inset/outer shadows. ZH: 将完整 CSS 外框放在可编辑内容下方；位图包含底色、边框和内外阴影。 -->
      <TabItem Header="独立预览"><ScrollViewer Background="#E8EBF0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid MinWidth="640" MinHeight="420"><Canvas x:Name="PreviewShadow" Width="420" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"/><Border x:Name="PreviewCard" Width="420" MinHeight="0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" Margin="24"><Grid><Canvas x:Name="PreviewLayers" IsHitTestVisible="False"/><TextBox x:Name="PreviewText" Text="在这里输入文字，测试样式和拉伸效果" TextWrapping="Wrap" AcceptsReturn="True" Padding="6,4" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"/></Grid></Border></Grid></ScrollViewer></TabItem>
   </TabControl>
<!-- EN: Keep layer management and selected/document properties together in the right-hand inspector.
     ZH: 在右侧属性区集中提供图层管理以及选中对象和文档属性。 -->
   <Border Grid.Column="2" Background="White" BorderBrush="#DDE2EB" BorderThickness="1,0,0,0"><ScrollViewer><StackPanel Margin="14">
    <TextBlock Text="图层" FontSize="15" FontWeight="Bold"/>
<!-- EN: Bind visibility and lock flags directly, support extended selection, and expose drag-drop reordering.
     ZH: 直接绑定可见性与锁定标记，支持扩展选择及拖放排序。 -->
    <ListBox x:Name="LayerList" Height="240" AllowDrop="True" SelectionMode="Extended" Margin="0,7">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}" Content="◉" ToolTip="{Binding VisibilityToolTip}" Click="LayerVisibilityChanged"/><CheckBox Grid.Column="1" IsChecked="{Binding IsLocked, Mode=TwoWay}" Content="🔒" ToolTip="{Binding LockToolTip}" Click="LayerLockChanged"/><TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
<!-- EN: Reorder the selected layer group or remove the selected objects.
     ZH: 调整选中图层组顺序或删除选中对象。 -->
    <WrapPanel><Button x:Name="UpBtn" Content="上移"/><Button x:Name="DownBtn" Content="下移"/><Button x:Name="TopBtn" Content="置顶"/><Button x:Name="BottomBtn" Content="置底"/><Button x:Name="DeleteBtn" Content="删除"/></WrapPanel>
    <Separator Margin="0,10"/>
<!-- EN: Edit portable style identity and frame fields that accompany layered compositions.
     ZH: 编辑随分层构图保存的可移植样式标识及外框字段。 -->
    <TextBlock Text="样式属性" FontSize="15" FontWeight="Bold"/>
    <TextBlock Style="{StaticResource Label}" Text="样式名称"/><TextBox x:Name="NameBox" Text="我的文本框样式"/>
    <!-- EN: Document all compatible ID characters. ZH: 文档化兼容 ID 允许的全部字符。 -->
    <TextBlock Style="{StaticResource Label}" Text="样式 ID（英文字母/数字/短横线/下划线）"/><TextBox x:Name="IdBox" Text="my-text-style"/>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="底色"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="BgBox" Text="#FFFFFF"/><Button x:Name="BgColorBtn" Grid.Column="1" Content="●" Margin="4,2,0,7" Padding="4" ToolTip="选择颜色"/></Grid></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="边框色"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="BorderBox" Text="#5B8DEF"/><Button x:Name="BorderColorBtn" Grid.Column="1" Content="●" Margin="4,2,0,7" Padding="4" ToolTip="选择颜色"/></Grid></StackPanel></UniformGrid>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="文字色"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="ColorBox" Text="#2C3140"/><Button x:Name="TextColorBtn" Grid.Column="1" Content="●" Margin="4,2,0,7" Padding="4" ToolTip="选择颜色"/></Grid></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="圆角"/><TextBox x:Name="RadiusBox" Text="12"/></StackPanel></UniformGrid>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="边框宽度"/><TextBox x:Name="BorderWidthBox" Text="1.5"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="字重"/><TextBox x:Name="FontWeightBox" Text="400"/></StackPanel></UniformGrid>
    <TextBlock Style="{StaticResource Label}" Text="阴影（CSS 格式）"/><TextBox x:Name="ShadowBox" Text="0 5px 16px #17203322"/>
    <!-- EN: Keep asynchronous frame diagnostics visible beside the CSS input without interrupting editing. ZH: 在 CSS 输入旁持续显示异步外框诊断，不中断编辑。 -->
    <TextBlock x:Name="FramePreviewStatus" TextWrapping="Wrap" Foreground="#697184" FontSize="12"/>
    <TextBlock Style="{StaticResource Label}" Text="内边距（CSS 格式）"/><TextBox x:Name="PaddingBox" Text="11px 18px"/>
<!-- EN: Use installed fonts; sizing selector tags remain uniform/stretch regardless of display language.
     ZH: 使用已安装字体；尺寸选择标签始终为 uniform/stretch，不随界面语言变化。 -->
    <TextBlock Style="{StaticResource Label}" Text="字体（读取 Windows 已安装字体）"/><ComboBox x:Name="FontBox" IsTextSearchEnabled="True" MaxDropDownHeight="320"/>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="字号"/><TextBox x:Name="FontSizeBox" Text="14"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="尺寸策略"/><ComboBox x:Name="SizeModeBox"><ComboBoxItem Tag="uniform" Content="固定长宽比"/><ComboBoxItem Tag="stretch" Content="自由拉伸"/></ComboBox></StackPanel></UniformGrid>
    <TextBlock Style="{StaticResource Label}" Text="文本框长宽比（可手动输入，如 1、1.5、16/9）"/><TextBox x:Name="AspectBox" Text="1.8"/>
<!-- EN: Edit shared input-rule fields; code-behind applies Unicode counts and whole-value regex validation.
     ZH: 编辑共享输入规则字段；后置代码负责 Unicode 计数及完整正则校验。 -->
    <Separator Margin="0,8"/><TextBlock Text="输入限制" FontWeight="Bold"/>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="最多字符（0=不限）"/><TextBox x:Name="MaxLengthBox" Text="0"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="允许类型"/><ComboBox x:Name="InputTypeBox"><ComboBoxItem Tag="any" Content="任意"/><ComboBoxItem Tag="number" Content="仅数字"/><ComboBoxItem Tag="letter" Content="仅字母"/><ComboBoxItem Tag="chinese" Content="仅中文"/><ComboBoxItem Tag="alnum" Content="数字和字母"/><ComboBoxItem Tag="regex" Content="自定义正则"/></ComboBox></StackPanel></UniformGrid>
    <TextBlock Style="{StaticResource Label}" Text="自定义正则"/><TextBox x:Name="PatternBox"/><CheckBox x:Name="RequiredBox" Content="不允许空值" Margin="0,2,0,8"/>
<!-- EN: Show the selected layer or text-region fields; irrelevant visual fields are disabled for the text region.
     ZH: 显示选中图层或文字区域字段；文字区域禁用不适用的外观字段。 -->
    <Separator Margin="0,8"/><TextBlock x:Name="SelectedObjectText" Text="选中对象" FontWeight="Bold"/>
    <TextBlock Style="{StaticResource Label}" Text="名称"/><TextBox x:Name="LayerNameBox"/>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="填充"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="LayerFillBox" Text="#DDE9FF"/><Button x:Name="LayerFillColorBtn" Grid.Column="1" Content="●" Margin="4,2,0,7" Padding="4" ToolTip="选择颜色"/></Grid></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="描边（始终实线）"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="LayerStrokeBox" Text="#5B8DEF"/><Button x:Name="LayerStrokeColorBtn" Grid.Column="1" Content="●" Margin="4,2,0,7" Padding="4" ToolTip="选择颜色"/></Grid></StackPanel></UniformGrid>
    <UniformGrid Columns="3"><StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource Label}" Text="线宽"/><TextBox x:Name="StrokeWidthBox" Text="1"/></StackPanel><StackPanel Margin="5,0"><TextBlock Style="{StaticResource Label}" Text="图层圆角"/><TextBox x:Name="LayerRadiusBox" Text="0"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Style="{StaticResource Label}" Text="透明度"/><TextBox x:Name="OpacityBox" Text="1"/></StackPanel></UniformGrid>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="旋转角度"/><TextBox x:Name="RotationBox" Text="0"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="混合模式"/><ComboBox x:Name="BlendModeBox"><ComboBoxItem Tag="normal" Content="正常"/><ComboBoxItem Tag="multiply" Content="正片叠底"/><ComboBoxItem Tag="screen" Content="滤色"/><ComboBoxItem Tag="overlay" Content="叠加"/></ComboBox></StackPanel></UniformGrid>
<!-- EN: Store positions and sizes as canvas percentages so the same composition can scale in preview and KnotJot.
     ZH: 以画布百分比保存位置尺寸，使相同构图可在预览及 KnotJot 中缩放。 -->
    <TextBlock Style="{StaticResource Label}" Text="位置和尺寸（相对画布百分比）"/>
    <UniformGrid Columns="4"><TextBlock Text="X" TextAlignment="Center"/><TextBlock Text="Y" TextAlignment="Center"/><TextBlock Text="宽度" TextAlignment="Center"/><TextBlock Text="高度" TextAlignment="Center"/></UniformGrid>
    <UniformGrid Columns="4"><TextBox x:Name="XBox"/><TextBox x:Name="YBox"/><TextBox x:Name="WBox"/><TextBox x:Name="HBox"/></UniformGrid>
<!-- EN: Display field errors and offer an explicit Apply action that commits an undo snapshot.
     ZH: 显示字段错误，并提供会记录撤销快照的显式应用操作。 -->
    <TextBlock x:Name="ValidationText" Foreground="#C53A4B" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <Button x:Name="ApplyBtn" Content="应用属性并刷新预览" Background="#E8F0FF" Margin="0,7,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
 </DockPanel>
<!-- EN: Offer new/open/connect entry points and language switching before showing the editing surface.
     ZH: 显示编辑界面前提供新建、打开、连接及语言切换入口。 -->
 <Grid x:Name="StartPage" Background="#F4F6F9">
  <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#25324A"><StackPanel Margin="34" VerticalAlignment="Center">
   <TextBlock Text="KnotJot" Foreground="White" FontSize="36" FontWeight="Bold"/>
   <TextBlock Text="文本框样式编辑器" Foreground="#DCE7FF" FontSize="20" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Grid Grid.Column="1"><StackPanel Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
   <DockPanel Margin="0,0,0,22"><TextBlock Text="开始" FontSize="30" FontWeight="Bold"/><Button x:Name="StartLanguageBtn" Content="EN" HorizontalAlignment="Right"/></DockPanel>
   <UniformGrid Columns="3">
    <Button x:Name="StartNewBtn" Height="130" Margin="7" Content="新建设计" FontSize="18"/>
    <Button x:Name="StartOpenBtn" Height="130" Margin="7" Content="打开样式" FontSize="18"/>
    <Button x:Name="StartConnectBtn" Height="130" Margin="7" Content="连接主程序" FontSize="18"/>
   </UniformGrid>
   <TextBlock Text="可以不连接主程序独立设计和预览；连接后可直接同步样式。" Foreground="#6E7789" TextAlignment="Center" Margin="0,22,0,0"/>
  </StackPanel></Grid>
 </Grid>
 </Grid>
</Window>

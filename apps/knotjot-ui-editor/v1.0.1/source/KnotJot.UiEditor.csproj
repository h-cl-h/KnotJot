<Project Sdk="Microsoft.NET.Sdk">

  <!-- Define the Windows runtime and project compilation identity.
       定义 Windows 运行时与项目编译身份。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KnotJot界面编辑器</AssemblyName>
    <RootNamespace>KnotJotUiEditor</RootNamespace>
    <Version>1.0.1</Version>
    <Product>KnotJot UI Editor</Product>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Declare package, source, content, or project dependencies for this build.
       声明本构建的软件包、源码、内容或工程依赖。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- Declare package, source, content, or project dependencies for this build.
       声明本构建的软件包、源码、内容或工程依赖。 -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <!-- EN: Share the KnotJot product icon between the executable and the window resource.
         ZH: 在可执行文件与窗口资源之间共用 KnotJot 产品图标。 -->
    <Resource Include="assets\icon.ico" />
  </ItemGroup>

  <!-- Declare package, source, content, or project dependencies for this build.
       声明本构建的软件包、源码、内容或工程依赖。 -->
  <ItemGroup>
    <!-- EN: Keep protocol, license and user documentation files outside the single-file bundle so repeated publishes retain required external installer inputs.
         ZH: 将协议、许可和用户文档保留在单文件程序之外，使重复发布仍保留安装器必需的外部输入。 -->
    <Content Include="protocols\ui-skin-protocol.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="README.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- EN: Ship the linked build guide with the user README for offline documentation.
         ZH: 将用户说明链接的构建指南一同发布，供离线查阅。 -->
    <None Update="DEVELOPMENT.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="THIRD_PARTY_LICENSES\**\*" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>

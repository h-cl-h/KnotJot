{
  "format": "knotjot-ui-skins",
  "version": 1,
  "locationFormat": "knotjot-skins-location",
  "projectApp": "knotjot-ui-editor-project",
  "projectSchema": "knotjot-ui-skin",
  "projectSchemaVersion": 2,
  "idPattern": "^[A-Za-z0-9_-]{3,80}$",
  "fileName": "ui-skins.json",
  "applicationDataDirectory": "KnotJot",
  "locationFileName": "skin-sync-location.json",
  "legacyApplicationDataDirectories": ["ThoughtCanvas"],
  "limits": {
    "libraryBytes": 16777216,
    "cssBytes": 2097152,
    "skinCount": 500,
    "nameCharacters": 60,
    "idCharacters": 80
  },
  "recordFields": [
    "name",
    "kind",
    "css",
    "base",
    "accent",
    "accentSoft",
    "schemaVersion",
    "updatedUtc",
    "contentHash",
    "writerId",
    "sourceFile",
    "editorData"
  ]
}
